{
  "name": "zsearch",
  "type": "module",
  "version": "1.0.0",
  "description": "Search, import and download Elsevier (Scopus/ScienceDirect) literature into Zotero, Google-Scholar style.",
  "config": {
    "addonName": "Zsearch",
    "addonID": "zsearch@zotero-plugin.dev",
    "addonRef": "zsearch",
    "addonInstance": "Zsearch",
    "prefsPrefix": "extensions.zotero.zsearch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zotero-plugin-dev/zsearch.git"
  },
  "author": "Zsearch",
  "bugs": {
    "url": "https://github.com/zotero-plugin-dev/zsearch/issues"
  },
  "homepage": "https://github.com/zotero-plugin-dev/zsearch#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": ["*.xhtml"],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
